# Vorlage für die Umgebungsvariablen.
# Lokal: Datei nach .env.local kopieren und echte Werte eintragen.
# Vercel: Werte unter Project Settings > Environment Variables eintragen.
# Echte Werte niemals committen.

# Passwort für die Kalenderseite. Nur an Freunde weitergeben.
CALENDAR_PASSWORD=

# Geheimer Schlüssel zum Signieren des Sitzungs-Cookies.
# Mindestens 32 Zeichen, zufällig erzeugt, z. B. mit: openssl rand -base64 32
SESSION_SECRET=

# ICS-Link des öffentlich geteilten Apple-Kalenders (iCloud).
# webcal:// darf stehen bleiben, die Seite wandelt es in https:// um.
CALENDAR_PRIVATE_ICS_URL=

# ICS-Link des Stundenplans der Hochschule.
CALENDAR_UNI_ICS_URL=

# Detailstufe der Kalenderanzeige:
#   busy = nur belegte Zeiten, ohne Titel und Ort
#   full = mit Titel und Ort
CALENDAR_DETAIL=busy
